# Public site URL used for canonical links, sitemap and Open Graph tags
VITE_SITE_URL=https://www.faultlens.space

# Form delivery endpoint. After deploying backend/faultlens-forms.template.json
# in AWS CloudFormation, paste the stack's "FormEndpoint" output here, e.g.
#   VITE_FORM_ENDPOINT=https://abc123xyz.execute-api.us-east-1.amazonaws.com/contact
# A Formspree form URL also works. When empty, forms fall back to opening a
# pre-filled email to shalom@faultlens.space; they never report a fake success.
VITE_FORM_ENDPOINT=

# Optional analytics: set to "true" once a Plausible or GA dataLayer script is added to index.html
VITE_ANALYTICS_ENABLED=false
