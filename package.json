{
  "name": "faultlens-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.js",
    "build:client": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "assets": "node scripts/render-assets.js",
    "docs": "node scripts/export-docs.js",
    "test": "node --test backend/form-handler/index.test.js",
    "backend:template": "node scripts/build-backend-template.js",
    "forms:local": "node scripts/local-form-server.js"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.7"
  }
}
